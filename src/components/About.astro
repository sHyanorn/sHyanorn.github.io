---
import Base from '../layouts/Base.astro'
import { t, toLang } from '../lib/i18n'

const lang = toLang(Astro.currentLocale)
---

<Base
  title={`${t(lang, 'about')} · Aaron Yang`}
  description={t(lang, 'aboutDescription')}
>
  <h1 class="rise">{t(lang, 'about')}</h1>

  <p class="location rise" style="--rise: 1">
    {t(lang, 'location')}
  </p>

  <section class="row rise" style="--rise: 2" aria-labelledby="direction">
    <h2 id="direction">{t(lang, 'direction')}</h2>
    <p>{t(lang, 'directionBody')}</p>
  </section>
</Base>

<style>
  h1 {
    padding-top: var(--space-4);
    font-size: var(--step-5);
    line-height: 1.1;
  }

  section {
    margin-top: var(--space-6);
  }

  section p {
    max-width: var(--width-prose);
  }

  /* A wide screen puts each heading beside its text, as on project pages. */
  @media (min-width: 48rem) {
    .row {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-line);
    }

    .row + .row {
      margin-top: var(--space-5);
    }

    .row h2 {
      margin: 0;
      font-size: var(--step-2);
    }
  }

  h2 {
    margin-bottom: var(--space-2);
    font-size: var(--step-2);
  }

  .location {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
